{
  "id": "word-order-conjunctions",
  "level": "A2",
  "title": "Wortstellung mit Konjunktionen",
  "group": "Word Order",
  "sourceFile": "wortstellung.html",
  "overviewSource": "wortstellungexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Coordinating conjunctions (und, aber, oder, denn, sondern) do not change word order. Subordinating conjunctions (weil, dass, wenn, ob…) send the conjugated verb to the end."
      },
      {
        "type": "example",
        "de": "Ich lerne, weil ich die Prüfung bestehen will.",
        "note": "weil … verb at end (bestehen will)"
      },
      {
        "type": "example",
        "de": "Ich lerne, aber er schläft.",
        "note": "aber — verb stays in position 2"
      }
    ]
  },
