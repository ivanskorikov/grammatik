  "title": "Komparative und Superlative 2",
  "group": "Adjectives",
  "sourceFile": "kompsuper2.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Use superlative to express the highest degree. Predicate superlative uses am + -sten; attributive uses der/die/das + -ste."
      },
      {
        "type": "example",
        "de": "Das ist das schönste Buch.",
        "note": "attributive superlative"
      }
    ]
  },
