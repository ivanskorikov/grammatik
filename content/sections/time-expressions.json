{
  "id": "time-expressions",
  "level": "A2",
  "title": "Wortstellung mit Zeitangaben",
  "group": "Word Order",
  "sourceFile": "zeitangaben.html",
  "overviewSource": "zeitangabenexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Time expressions often come early in the sentence (after the verb or in position 1). Use accusative for definite time spans, dative for dates and seasons in some contexts."
      },
      {
        "type": "example",
        "de": "Am Montag gehe ich ins Kino.",
        "note": "am = an + dem (dative)"
      },
      {
        "type": "example",
        "de": "Jeden Tag lerne ich Deutsch.",
        "note": "jeden Tag = accusative time expression"
      }
    ]
  },
