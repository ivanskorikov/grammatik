  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Attributive adjectives (before a noun) take endings based on the preceding article. Strong declension: no article → more endings. Weak: after der/die/das → mostly -e/-en."
      },
      {
        "type": "example",
        "de": "Deutsches Brot schmeckt gut.",
        "note": "no article → strong ending -es"
      },
      {
        "type": "example",
        "de": "Das deutsche Brot schmeckt gut.",
        "note": "after das → weak ending -e"
      }
    ]
  },
