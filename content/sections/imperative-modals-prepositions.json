  "title": "Wiederholung: Imperative, Modalverben und Akkusativpräpositionen",
  "group": "Review",
  "sourceFile": "impmodalpraeps.html",
  "overviewSource": "imperativesexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "The imperative gives commands. Du-form often drops the -st ending; Sie-form uses the infinitive + Sie."
      },
      {
        "type": "list",
        "content": "Komm! / Kommen Sie! — Come!\nLies! / Lesen Sie! — Read!\nSeid leise! — Be quiet! (ihr-form)"
      },
      {
        "type": "example",
        "de": "Gehen Sie bitte nach links.",
        "note": "formal imperative"
      }
    ]
  },
