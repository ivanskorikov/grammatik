{
  "id": "two-way-prepositions-1",
  "level": "A2",
  "title": "Wechselpräpositionen 1",
  "group": "Prepositions",
  "sourceFile": "wechselpraeps1.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Two-way prepositions take accusative for a destination/change of position (wohin?) and dative for a fixed location (wo?). Movement alone does not guarantee accusative."
      },
      {
        "type": "list",
        "content": "an, auf, hinter, in, neben, über, unter, vor, zwischen"
      },
      {
        "type": "table",
        "content": "",
        "rows": [
          [
            "Question",
            "Meaning",
            "Case",
            "Example"
          ],
          [
            "wohin?",
            "destination/change",
            "Acc.",
            "in die Schule"
          ],
          [
            "wo?",
            "location/state",
            "Dat.",
            "in der Schule"
          ]
        ]
      },
      {
        "type": "example",
        "content": "",
        "de": "Ich laufe im Park. / Ich laufe in den Park.",
        "note": "running inside the park = location; entering it = destination"
      }
    ]
  },
