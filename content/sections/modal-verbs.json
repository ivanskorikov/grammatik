{
  "id": "modal-verbs",
  "level": "A1",
  "title": "Modalverben und Imperative",
  "group": "Verbs",
  "sourceFile": "modalverben.html",
  "overviewSource": "modalverbenexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Modal verbs express ability, permission, obligation, or desire. The main verb goes to the end in infinitive form."
      },
      {
        "type": "list",
        "content": "können (can)\nmüssen (must)\nwollen (want to)\ndürfen (may)\nsollen (should)"
      },
      {
        "type": "example",
        "de": "Ich kann Deutsch sprechen.",
        "note": "modal + infinitive at end"
      },
      {
        "type": "example",
        "de": "Du musst heute lernen.",
        "note": "müssen + infinitive"
      }
    ]
  },
