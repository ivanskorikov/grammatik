  "group": "Verbs",
  "sourceFile": "reflexiv2.html",
  "overviewSource": "reflexexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Some reflexive verbs take an optional dative object. Accusative reflexive is most common at A2."
      },
      {
        "type": "example",
        "de": "Ich freue mich auf das Wochenende.",
        "note": "sich freuen auf + accusative"
      }
    ]
  },
