{
  "id": "accusative-prepositions",
  "level": "A1",
  "title": "Akkusativpräpositionen",
  "group": "Cases",
  "sourceFile": "akkuspraeps.html",
  "overviewSource": "akkuspraepsexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "These prepositions always take the accusative case. The noun that follows must be in accusative form."
      },
      {
        "type": "list",
        "content": "durch (through)\nfür (for)\ngegen (against)\nohne (without)\num (around, at [time])\nentlang (along — follows the noun)"
      },
      {
        "type": "example",
        "de": "Das Geschenk ist für den Mann.",
        "note": "für + accusative → den Mann"
      },
      {
        "type": "example",
        "de": "Wir fahren durch die Stadt.",
        "note": "durch + accusative → die Stadt"
      }
    ]
  },
