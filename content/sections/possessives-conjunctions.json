{
  "id": "possessives-conjunctions",
  "level": "A2",
  "title": "Possessive und Konjunktionen",
  "group": "Adjectives",
  "sourceFile": "possessiv.html",
  "overviewSource": "possessivexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Possessive articles identify the owner but take endings from the possessed noun’s gender, number, and case. They decline like ein."
      },
      {
        "type": "table",
        "content": "",
        "rows": [
          [
            "Owner",
            "Stem",
            "Example"
          ],
          [
            "ich",
            "mein-",
            "mein Buch"
          ],
          [
            "du",
            "dein-",
            "deine Tasche"
          ],
          [
            "er/es",
            "sein-",
            "seinen Bruder"
          ],
          [
            "sie",
            "ihr-",
            "ihrem Kind"
          ],
          [
            "wir",
            "unser-",
            "unsere Freunde"
          ],
          [
            "ihr",
            "euer-",
            "eure Eltern"
          ],
          [
            "sie/Sie",
            "ihr-/Ihr-",
            "ihre/Ihre Wohnung"
          ]
        ]
      },
      {
        "type": "paragraph",
        "content": "Euer drops the second e before most endings: eure, euren, eurem—not euere."
      },
      {
        "type": "example",
        "content": "",
        "de": "Das ist mein Bruder, aber ich sehe meinen Bruder heute nicht.",
        "note": "mein = nom. masc. · meinen = acc. masc."
      },
      {
        "type": "heading",
        "content": "Conjunction review"
      },
      {
        "type": "table",
        "content": "",
        "rows": [
          [
            "Type",
            "Words",
            "Word order"
          ],
          [
            "Coordinating",
            "und, aber, oder, denn, sondern",
            "normal V2"
          ],
          [
            "Subordinating",
            "weil, dass, wenn, ob",
            "conjugated verb at end"
          ],
          [
            "Conjunctive adverb",
            "deshalb, trotzdem, dann",
            "verb immediately after"
          ]
        ]
      },
      {
        "type": "example",
        "content": "",
        "de": "Ich besuche meine Schwester, weil ihr Geburtstag heute ist.",
        "note": "meine = acc. fem. · ihr = possessive · ist at end after weil"
      }
    ]
  },
