{
  "id": "dative",
  "level": "A2",
  "title": "Der Dativ",
  "group": "Cases",
  "sourceFile": "dativ.html",
  "overviewSource": "dativexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "The dative case marks the indirect object — the recipient or beneficiary. Ask: \"To/for whom?\" Masculine and neuter articles become dem; feminine die → der; plural die → den (+ n on noun sometimes)."
      },
      {
        "type": "table",
        "content": "",
        "rows": [
          [
            "",
            "Nom.",
            "Dat."
          ],
          [
            "Masc.",
            "der / ein",
            "dem / einem"
          ],
          [
            "Fem.",
            "die / eine",
            "der / einer"
          ],
          [
            "Neut.",
            "das / ein",
            "dem / einem"
          ],
          [
            "Plural",
            "die",
            "den (+n)"
          ]
        ]
      },
      {
        "type": "example",
        "de": "Ich gebe dem Mann das Buch.",
        "note": "dem Mann = dative indirect object"
      },
      {
        "type": "example",
        "de": "Das Buch gehört der Frau.",
        "note": "der Frau = dative after gehören"
      }
    ]
  },
