{
  "id": "pronouns-questions",
  "level": "A1",
  "title": "Wiederholung: Pronomen und Fragen",
  "group": "Basics",
  "sourceFile": "pronomfragen.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "Question words (W-words) come first, then the verb (V2 rule). Yes/no questions start with the verb."
      },
      {
        "type": "list",
        "content": "wer — who\nwas — what\nwo — where\nwann — when\nwarum — why\nwie — how\nwoher — from where\nwohin — to where"
      },
      {
        "type": "example",
        "de": "Wo wohnst du?",
        "note": "W-word + verb + subject"
      },
      {
        "type": "example",
        "de": "Kommst du morgen?",
        "note": "yes/no: verb first"
      }
    ]
  },
