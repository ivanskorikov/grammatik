{
  "id": "verbs-articles-negation",
  "level": "A1",
  "title": "Wiederholung: Verben, Artikel und Negation",
  "group": "Verbs",
  "sourceFile": "verbartiknegat.html",
  "overviewSource": "negationexpl.html",
  "overview": {
    "blocks": [
      {
        "type": "paragraph",
        "content": "This section reviews present-tense verb endings, nominative/accusative articles, and the difference between nicht and kein."
      },
      {
        "type": "heading",
        "content": "Present-tense verbs"
      },
      {
        "type": "table",
        "content": "",
        "rows": [
          [
            "Subject",
            "Ending",
            "spielen"
          ],
          [
            "ich",
            "-e",
            "spiele"
          ],
          [
            "du",
            "-st",
            "spielst"
          ],
          [
            "er/sie/es",
            "-t",
            "spielt"
          ],
          [
            "wir/sie/Sie",
            "-en",
            "spielen"
          ],
          [
            "ihr",
            "-t",
            "spielt"
          ]
        ]
      },
      {
        "type": "heading",
        "content": "Article reminder"
      },
      {
        "type": "table",
        "content": "",
        "rows": [
          [
            "",
            "Masc.",
            "Fem.",
            "Neut.",
            "Plural"
          ],
          [
            "Nominative",
            "der/ein",
            "die/eine",
            "das/ein",
            "die"
          ],
          [
            "Accusative",
            "den/einen",
            "die/eine",
            "das/ein",
            "die"
          ]
        ]
      },
      {
        "type": "heading",
        "content": "Negation: nicht or kein?"
      },
      {
        "type": "paragraph",
        "content": "Kein replaces ein/eine or negates a noun with no article; nicht negates verbs, adjectives, adverbs, proper names, or a specific phrase."
      },
      {
        "type": "table",
        "content": "",
        "rows": [
          [
            "Use",
            "Negative",
            "Example"
          ],
          [
            "indefinite/no-article noun",
            "kein",
            "Ich habe kein Auto."
          ],
          [
            "verb or whole statement",
            "nicht",
            "Ich komme heute nicht."
          ],
          [
            "adjective/adverb",
            "nicht",
            "Das ist nicht teuer."
          ],
          [
            "definite noun/phrase",
            "nicht",
            "Ich kaufe nicht das rote Auto."
          ]
        ]
      },
      {
        "type": "paragraph",
        "content": "Kein declines like ein: kein Mann, keine Frau, kein Kind, keine Kinder; accusative masculine becomes keinen."
      },
      {
        "type": "example",
        "content": "",
        "de": "Ich trinke keinen Kaffee, aber der Tee ist nicht schlecht.",
        "note": "keinen negates a masculine noun · nicht negates an adjective"
      }
    ]
  },
